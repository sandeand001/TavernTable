{
  "name": "taverntable",
  "version": "1.0.0",
  "description": "An isometric grid-based tabletop game interface",
  "main": "index.html",
  "scripts": {
    "format": "prettier --write \"{src,tests,tools,docs}/**/*.{js,css,html,json}\"",
    "format:check": "prettier --check \"{src,tests,tools,docs}/**/*.{js,css,html,json}\"",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=tests/unit/",
    "test:integration": "jest --testPathPatterns=tests/integration/",
    "test:stable": "jest --detectOpenHandles --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint --cache \"{src,tools,tests}/**/*.js\" && stylelint -c tools/.stylelintrc.json \"src/**/*.css\"",
    "lint:js": "eslint --cache \"{src,tools,tests}/**/*.js\"",
    "lint:css": "stylelint -c tools/.stylelintrc.json \"src/**/*.css\"",
    "lint:fix": "eslint --cache \"{src,tools,tests}/**/*.js\" --fix && stylelint -c tools/.stylelintrc.json \"src/**/*.css\" --fix",
    "lint:layers": "node tools/check-layering.js",
    "lint:all": "npm run lint && npm run lint:layers",
    "resources:sync": "node tools/sync-resources.js",
    "resources:cover": "node tools/measure-cover-poses.js --write",
    "resources:cover:check": "node tools/measure-cover-poses.js --check",
    "serve": "node tools/local-host.js --port 3000",
    "serve:alt": "npm run serve:alt1",
    "serve:alt1": "node tools/local-host.js --port 3001",
    "serve:alt2": "node tools/local-host.js --port 3002",
    "serve:alt3": "node tools/local-host.js --port 3003",
    "serve:alt4": "node tools/local-host.js --port 3004",
    "start": "npm run serve",
    "serve:open": "start \"\" http://localhost:3000 && npm run serve",
    "prepare": "node tools/install-git-hooks.js",
    "test:cloud": "node tools/cloud/run-emulator-tests.js",
    "dev:cloud": "node tools/cloud/run-emulator-tests.js --serve",
    "build:cloud:frontend": "node tools/cloud/build-frontend.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "acorn": "^8.15.0",
    "babel-jest": "^30.0.5",
    "canvas": "^3.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "fake-indexeddb": "^6.2.7",
    "fast-glob": "^3.3.3",
    "firebase-tools": "15.11.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "lint-staged": {
    "{src,tests,tools}/**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.css": [
      "prettier --write",
      "stylelint -c tools/.stylelintrc.json --fix"
    ]
  },
  "keywords": [
    "game",
    "tabletop",
    "isometric"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cannon-es": "0.20.0",
    "fast-json-stable-stringify": "^2.1.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "image-size": "2.1.0",
    "sharp": "0.35.5",
    "three": "^0.170.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeand001/TavernTable.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sandeand001/TavernTable/issues"
  },
  "homepage": "https://github.com/sandeand001/TavernTable#readme",
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.7"
  }
}
